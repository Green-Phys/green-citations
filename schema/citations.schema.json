{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version", "policy-status", "policy-note", "components"],
  "properties": {
    "schema-version": {"const": 1},
    "policy-status": {"enum": ["draft", "approved"]},
    "policy-note": {"type": "string", "minLength": 1},
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "implementation", "historical", "versions", "methods", "method-mapping-status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "implementation": {"$ref": "#/$defs/keys"},
        "historical": {"$ref": "#/$defs/keys"},
        "versions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/keys"}
        },
        "methods": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/keys"}
        },
        "method-mapping-status": {"enum": ["review-required", "approved"]},
        "method-mapping-note": {"type": "string"}
      }
    }
  }
}

